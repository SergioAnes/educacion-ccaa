{
  "indicador_id": "sueldo_docente",
  "periodos": [
    "2026"
  ],
  "cautela": [
    {
      "territorio": "13",
      "texto": "Las dos pagas adicionales del complemento específico se dan por cobradas también por los docentes: la ley las fija para los funcionarios en general."
    },
    {
      "territorio": "09",
      "texto": "Incluye un pago único en mayo de 2026 (839 € maestros, 858 € secundaria), primer tramo de una subida que desde 2027 va en la nómina mensual."
    },
    {
      "territorio": "10",
      "texto": "Las dos pagas adicionales del complemento específico se dan por cobradas también por los docentes: la ley las fija para los funcionarios en general. Incluye la subida de 75 € desde septiembre de 2026."
    },
    {
      "territorio": "16",
      "texto": "Incluye el segundo y el tercer sexenio, que en el País Vasco se cobran desde el primer día (4.435 € al año), y un complemento de destino propio."
    },
    {
      "territorio": "04",
      "texto": "Incluye la indemnización por residencia de Mallorca, que cobra todo el personal público; en Menorca, Ibiza y Formentera es mayor. No incluye el primer tramo de la carrera profesional docente: se cobra tras una evaluación favorable y no se ha podido confirmar si exige años de servicio."
    },
    {
      "territorio": "07",
      "texto": "Incluye una «consolidación» de unos 25-27 € al mes que la orden no dice a quién se aplica."
    },
    {
      "territorio": "03",
      "texto": "Las dos pagas adicionales del complemento específico se dan por cobradas también por los docentes: la ley las fija para los funcionarios en general."
    },
    {
      "territorio": "06",
      "texto": "Las dos pagas adicionales del complemento específico se dan por cobradas también por los docentes: la ley las fija para los funcionarios en general."
    },
    {
      "territorio": "08",
      "texto": "Las dos pagas adicionales del complemento específico se dan por cobradas también por los docentes: la ley las fija para los funcionarios en general."
    },
    {
      "territorio": "14",
      "texto": "Importes de 2026 calculados: los de 2025 publicados en el BORM más la subida general del 1,5 % (coinciden con la guía de CCOO de enero de 2026). Parte del sueldo se paga como «productividad»."
    },
    {
      "territorio": "15",
      "texto": "Navarra tiene un régimen de sueldos propio (sueldo por nivel y complemento docente en porcentaje); el complemento se calcula con el porcentaje de la ley foral."
    },
    {
      "territorio": "17",
      "texto": "Para secundaria se usa la tabla oficial de enero (825,47 € de específico); una tabla sindical de noviembre da un 1,5 % más."
    },
    {
      "territorio": "05",
      "texto": "Incluye la indemnización por residencia de isla mayor (Gran Canaria y Tenerife); en las islas menores es mayor."
    },
    {
      "territorio": "01",
      "texto": "Dato reconstruido: la Junta no ha publicado la tabla de 2026; se calcula con la tabla oficial de 2024 y los acuerdos publicados en el BOJA (coincide con la tabla de UGT de enero de 2026)."
    }
  ],
