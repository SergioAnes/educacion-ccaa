AXIS-VERSION="2006";
CREATION-DATE="20261125";
CHARSET="ANSI";
SUBJECT-AREA="ESTADÍSTICA DE BECAS Y AYUDAS AL ESTUDIO / TODAS LAS ENSEÑANZAS / CURSO 2020-2";
SUBJECT-CODE="BECAS";
MATRIX="1";
TITLE="2. Número de becarios, número de becas y ayudas e importe  por  comunidad autónoma de destino, becarios, becas e importe , tipo de  enseñanzas y nivel de administración educativa financiadora.";
CONTENTS="2. Número de becarios, número de becas y ayudas e im";
CODEPAGE="iso-8859-15";
DESCRIPTION="";
COPYRIGHT=YES;
NOTE="1) El número de becarios puede estar ligeramente sobredimensionado  porque cu"
"ando no ha sido posible determinar el número de  beneficiarios de más de una "
"beca se ha hecho la hipótesis de  considerar un becario por beca. No obstante"
", en el curso 2020-2021 se  ha hecho un esfuerzo por parte de las Administrac"
"iones educativas en  eliminar duplicidades que puede afectar a la comparabili"
"dad de esta  variable con cursos anteriores.        # 2) Los becarios que rec"
"iben becas del Ministerio y de una Comunidad  se contabilizan en ambas admini"
"straciones y por tanto aparecen  duplicados.        # 3) En el curso 2020-202"
"1 se incluyen por primera vez las ayudas de  primer ciclo de Ed. Infantil de "
"la Administración educativa de  Andalucía, aunque se vienen ofreciendo desde "
"el curso 2017-2018.     # 4) Los datos de Enseñanzas obligatorias, E. Infanti"
"l y E. Especial y  de Enseñanzas postobligatorias no universitarias dependien"
"tes de la  Administración educativa de Galicia son provisionales.      # 5) E"
"n Sin especificar C.A./Universidad del Ministerio, becarios,  becas e importe"
"s de enseñanzas obligatorias corresponden a ayudas de  libros y material para"
" alumnado de Centros en el exterior.";
DECIMALS=1;
SHOWDECIMALS=1;
STUB="Comunidad autónoma de destino";
HEADING="Becarios, becas e importe","Tipo de enseñanzas","Nivel de administración educativa financiadora";
